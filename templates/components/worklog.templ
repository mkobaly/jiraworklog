package components

import (
	"fmt"
	"github.com/mkobaly/jiraworklog/types"
)

templ WorklogList(worklogs []types.WorklogItem) {
	<div class="bg-white rounded-lg shadow-md overflow-hidden">
		<div class="overflow-x-auto">
			<table class="min-w-full divide-y divide-gray-200">
				<thead class="bg-gray-50">
					<tr>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Author</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Issue</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Summary</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Hours</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Project</th>
					</tr>
				</thead>
				<tbody class="bg-white divide-y divide-gray-200">
					for _, wl := range worklogs {
						@WorklogRow(&wl)
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ WorklogRow(wl *types.WorklogItem) {
	<tr class="hover:bg-gray-50 transition">
		<td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
			{ wl.Date.Format("2006-01-02") }
		</td>
		<td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
			{ wl.Author }
		</td>
		<td class="px-4 py-3 whitespace-nowrap text-sm">
			<a href={ templ.SafeURL(fmt.Sprintf("/issues/%s", wl.IssueKey)) } class="text-blue-600 hover:text-blue-800 font-medium">
				{ wl.IssueKey }
			</a>
		</td>
		<td class="px-4 py-3 text-sm text-gray-900">
			<div class="max-w-xs truncate" title={ wl.IssueSummary }>
				{ wl.IssueSummary }
			</div>
		</td>
		<td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
			{ fmt.Sprintf("%.2f", wl.TimeSpentHours) }
		</td>
		<td class="px-4 py-3 whitespace-nowrap text-sm">
			<span class="px-2 py-1 text-xs font-medium rounded-full bg-blue-100 text-blue-800">
				{ wl.Project }
			</span>
		</td>
	</tr>
}

templ WorklogCard(wl *types.WorklogItem) {
	<div class="bg-white rounded-lg shadow-md p-4 mb-3 border-l-4 border-blue-500">
		<div class="flex justify-between items-start mb-2">
			<div class="flex-1">
				<a href={ templ.SafeURL(fmt.Sprintf("/issues/%s", wl.IssueKey)) } class="text-blue-600 hover:text-blue-800 font-bold text-lg">
					{ wl.IssueKey }
				</a>
				<span class="ml-2 px-2 py-1 text-xs font-medium rounded-full bg-blue-100 text-blue-800">
					{ wl.Project }
				</span>
			</div>
			<div class="text-right">
				<div class="text-lg font-bold text-gray-900">{ fmt.Sprintf("%.2f", wl.TimeSpentHours) }h</div>
			</div>
		</div>

		<p class="text-gray-700 text-sm mb-2">{ wl.IssueSummary }</p>

		<div class="flex justify-between items-center text-xs text-gray-500 mt-3 pt-3 border-t">
			<div>
				<span class="font-medium">{ wl.Author }</span>
			</div>
			<div>
				{ wl.Date.Format("Jan 02, 2006") }
			</div>
		</div>
	</div>
}

templ WorklogMobileList(worklogs []types.WorklogItem) {
	<div class="md:hidden">
		for _, wl := range worklogs {
			@WorklogCard(&wl)
		}
	</div>
	<div class="hidden md:block">
		@WorklogList(worklogs)
	</div>
}

templ WorklogsGroupByCard(data *types.WorklogGroupByChart) {
	<div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition">
		<div class="flex justify-between items-start">
			<div class="flex-1">
				<h3 class="text-lg font-bold text-gray-900">{ data.GroupBy }</h3>
				<p class="text-sm text-gray-500 mt-1">Total Hours Logged</p>
			</div>
			<div class="text-right">
				<div class="text-2xl font-bold text-blue-600">
					{ fmt.Sprintf("%.1f", data.TimeSpentHrs) }
				</div>
				<p class="text-xs text-gray-500">hours</p>
			</div>
		</div>
	</div>
}
