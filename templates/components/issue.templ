package components

import (
	"fmt"
	"github.com/mkobaly/jiraworklog/types"
)

templ IssueList(issues []types.ParentIssue) {
	<div class="bg-white rounded-lg shadow-md overflow-hidden">
		<div class="overflow-x-auto">
			<table class="min-w-full divide-y divide-gray-200">
				<thead class="bg-gray-50">
					<tr>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Key</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Summary</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Priority</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Time Spent</th>
						<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estimate</th>
					</tr>
				</thead>
				<tbody class="bg-white divide-y divide-gray-200">
					for _, issue := range issues {
						@IssueRow(&issue)
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ IssueRow(issue *types.ParentIssue) {
	<tr class="hover:bg-gray-50 transition">
		<td class="px-4 py-3 whitespace-nowrap text-sm">
			<a href={ templ.SafeURL(fmt.Sprintf("/issues/%s", issue.Key)) } class="text-blue-600 hover:text-blue-800 font-medium">
				{ issue.Key }
			</a>
		</td>
		<td class="px-4 py-3 whitespace-nowrap text-sm">
			<span class="px-2 py-1 text-xs font-medium rounded-full bg-purple-100 text-purple-800">
				{ issue.Type }
			</span>
		</td>
		<td class="px-4 py-3 text-sm text-gray-900">
			<div class="max-w-md truncate" title={ issue.Summary }>
				{ issue.Summary }
			</div>
		</td>
		<td class="px-4 py-3 whitespace-nowrap text-sm">
			if issue.IsResolved {
				<span class="px-2 py-1 text-xs font-medium rounded-full bg-green-100 text-green-800">
					Resolved
				</span>
			} else {
				<span class="px-2 py-1 text-xs font-medium rounded-full bg-yellow-100 text-yellow-800">
					{ issue.Status }
				</span>
			}
		</td>
		<td class="px-4 py-3 whitespace-nowrap text-sm">
			@PriorityBadge(issue.Priority)
		</td>
		<td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
			{ fmt.Sprintf("%.1f", float64(issue.AggregateTimeSpent)/3600) }h
		</td>
		<td class="px-4 py-3 whitespace-nowrap text-sm text-gray-900">
			if issue.AggregateTimeOriginalEstimate > 0 {
				{ fmt.Sprintf("%.1f", float64(issue.AggregateTimeOriginalEstimate)/3600) }h
			} else {
				<span class="text-gray-400">-</span>
			}
		</td>
	</tr>
}

templ IssueCard(issue *types.ParentIssue) {
	<div class="bg-white rounded-lg shadow-md p-4 mb-3 border-l-4 border-purple-500">
		<div class="flex justify-between items-start mb-2">
			<div class="flex-1">
				<a href={ templ.SafeURL(fmt.Sprintf("/issues/%s", issue.Key)) } class="text-blue-600 hover:text-blue-800 font-bold text-lg">
					{ issue.Key }
				</a>
				<div class="mt-1 flex flex-wrap gap-2">
					<span class="px-2 py-1 text-xs font-medium rounded-full bg-purple-100 text-purple-800">
						{ issue.Type }
					</span>
					@PriorityBadge(issue.Priority)
				</div>
			</div>
			<div class="text-right">
				if issue.IsResolved {
					<span class="px-2 py-1 text-xs font-medium rounded-full bg-green-100 text-green-800">
						Resolved
					</span>
				} else {
					<span class="px-2 py-1 text-xs font-medium rounded-full bg-yellow-100 text-yellow-800">
						{ issue.Status }
					</span>
				}
			</div>
		</div>

		<p class="text-gray-700 text-sm mb-3">{ issue.Summary }</p>

		<div class="flex justify-between items-center text-xs text-gray-500 pt-3 border-t">
			<div>
				<span class="font-medium">Time Spent:</span> { fmt.Sprintf("%.1f", float64(issue.AggregateTimeSpent)/3600) }h
			</div>
			<div>
				if issue.AggregateTimeOriginalEstimate > 0 {
					<span class="font-medium">Est:</span> { fmt.Sprintf("%.1f", float64(issue.AggregateTimeOriginalEstimate)/3600) }h
				}
			</div>
		</div>
	</div>
}

templ IssueMobileList(issues []types.ParentIssue) {
	<div class="md:hidden">
		for _, issue := range issues {
			@IssueCard(&issue)
		}
	</div>
	<div class="hidden md:block">
		@IssueList(issues)
	</div>
}

templ PriorityBadge(priority string) {
	if priority == "Critical" || priority == "Highest" {
		<span class="px-2 py-1 text-xs font-medium rounded-full bg-red-100 text-red-800">
			{ priority }
		</span>
	} else if priority == "High" {
		<span class="px-2 py-1 text-xs font-medium rounded-full bg-orange-100 text-orange-800">
			{ priority }
		</span>
	} else if priority == "Medium" {
		<span class="px-2 py-1 text-xs font-medium rounded-full bg-yellow-100 text-yellow-800">
			{ priority }
		</span>
	} else {
		<span class="px-2 py-1 text-xs font-medium rounded-full bg-gray-100 text-gray-800">
			{ priority }
		</span>
	}
}

templ IssueChartDataCard(data *types.IssueChartData) {
	<div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition">
		<h3 class="text-lg font-bold text-gray-900 mb-4">{ data.GroupBy }</h3>

		<div class="grid grid-cols-2 gap-4">
			<div>
				<p class="text-xs text-gray-500">Resolved</p>
				<p class="text-2xl font-bold text-green-600">{ fmt.Sprintf("%d", data.Resolved) }</p>
			</div>
			<div>
				<p class="text-xs text-gray-500">Open</p>
				<p class="text-2xl font-bold text-yellow-600">{ fmt.Sprintf("%d", data.NonResolved) }</p>
			</div>
			<div>
				<p class="text-xs text-gray-500">Avg Days to Resolve</p>
				<p class="text-xl font-bold text-blue-600">{ fmt.Sprintf("%d", data.DaysToResolve) }</p>
			</div>
			<div>
				<p class="text-xs text-gray-500">Time Spent</p>
				<p class="text-xl font-bold text-purple-600">{ fmt.Sprintf("%.1f", data.TimeSpent) }h</p>
			</div>
		</div>
	</div>
}

templ IssueAccuracyCard(data *types.IssueAccuracy) {
	<div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition">
		<div class="flex justify-between items-start">
			<div class="flex-1">
				<h3 class="text-lg font-bold text-gray-900">{ data.Developer }</h3>
				<p class="text-sm text-gray-500 mt-1">{ fmt.Sprintf("%d issues", data.Count) }</p>
			</div>
			<div class="text-right">
				<div class="text-2xl font-bold" class={ templ.KV("text-green-600", data.Accuracy >= 90), templ.KV("text-yellow-600", data.Accuracy >= 70 && data.Accuracy < 90), templ.KV("text-red-600", data.Accuracy < 70) }>
					{ fmt.Sprintf("%.1f%%", data.Accuracy) }
				</div>
				<p class="text-xs text-gray-500">accuracy</p>
			</div>
		</div>
	</div>
}
