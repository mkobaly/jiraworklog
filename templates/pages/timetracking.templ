func overBudgetColor(count int) string {
	if count == 0 {
		return "text-green-600"
	}
	return "text-red-600"
}

func progressBarColor(progress float64) string {
	if progress > 100 {
		return "bg-red-500"
	} else if progress > 80 {
		return "bg-yellow-500"
	}
	return "bg-green-500"
}

func progressTextColor(progress float64) string {
	if progress > 100 {
		return "text-red-600"
	} else if progress > 80 {
		return "text-yellow-600"
	}
	return "text-green-600"
}

func min(a, b float64) float64 {
	if a < b {
		return a
	}
	return b
}
