package pages

import (
	"fmt"
	"github.com/mkobaly/jiraworklog/templates/layouts"
	"github.com/mkobaly/jiraworklog/types"
)

type SummaryWidget struct {
	TotalIssues int
	EstimateTotal int32
	DevTimeTotal int32
	JiraRemainingTimeTotal int32 //This represents the remaining time displayed in Jira. 
	RemainingTimeTotal int32 //This represents Estimate - DevTime logged
	IssuesOverBudget int
}

// IssueGroup represents a parent issue with its children
type IssueGroup struct {
	Parent   *types.ProjectTimeTracking
	Children []types.ProjectTimeTracking
	Totals AggregatedTotals
}

// AggregatedTotals holds the combined estimate and dev time for a group
type AggregatedTotals struct {
	EstimateSeconds int32
	DevSeconds      int32
	JiraRemainingSeconds int32
}

// Progress returns the percentage of dev time vs estimate
func (a AggregatedTotals) Progress() float64 {
	if a.EstimateSeconds == 0 {
		return 0
	}
	return float64(a.DevSeconds) / float64(a.EstimateSeconds) * 100
}

func (a AggregatedTotals) RemainingDevSeconds() int32 {
	remaining := a.EstimateSeconds - a.DevSeconds
	if remaining > 0 {
		return remaining
	}
	return 0
}

// IsOverBudget returns true if dev time exceeds estimate
func (a AggregatedTotals) IsOverBudget() bool {
	return a.Progress() > 100
}

templ ProjectTimeTracking(issues []types.ProjectTimeTracking, fixedVersion string) {
	@layouts.Base("Project Time Tracking") {
		<style>
			main.container { max-width: none !important; }
		</style>
		<div class="mb-6">
			<h1 class="text-3xl font-bold text-gray-900">Project Time Tracking</h1>
			<p class="text-gray-600 mt-2">View time tracking progress for issues in a specific version</p>
		</div>

		<!-- Version Input Form -->
		<div class="bg-white rounded-lg shadow-md p-6 mb-6">
			<form action="/reports/time-tracking" method="GET" class="flex flex-col sm:flex-row gap-4">
				<div class="flex-grow">
					<label for="version" class="block text-sm font-medium text-gray-700 mb-1">Fixed Version / Epic</label>
					<input
						type="text"
						id="version"
						name="version"
						value={ fixedVersion }
						placeholder="Enter fixed version or epic"
						class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
					/>
				</div>
				<div class="flex items-end">
					<button
						type="submit"
						class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition font-medium"
					>
						Search
					</button>
				</div>
			</form>
		</div>

		if fixedVersion == "" {
			<div class="bg-blue-50 border-l-4 border-blue-400 p-4">
				<div class="flex">
					<div class="flex-shrink-0">
						<svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
						</svg>
					</div>
					<div class="ml-3">
						<p class="text-blue-700">Enter a fixed version above to view time tracking data.</p>
					</div>
				</div>
			</div>
		} else if len(issues) == 0 {
			<div class="bg-yellow-50 border-l-4 border-yellow-400 p-4">
				<div class="flex">
					<div class="flex-shrink-0">
						<svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
						</svg>
					</div>
					<div class="ml-3">
						<p class="text-yellow-700">No issues found for version "{ fixedVersion }".</p>
					</div>
				</div>
			</div>
		} else {
			<!-- Summary Stats -->
			<div class="grid grid-cols-1 md:grid-cols-6 gap-4 mb-6">
				@timeTrackingSummary(issues)
			</div>

			<div class="px-4 py-3 bg-gray-50 border-b flex items-center justify-between rounded-t-lg">
				<h2 class="text-lg font-semibold text-gray-900">
					<span id="visible-issue-count">{ fmt.Sprintf("%d", len(issues)) }</span> Issues in { fixedVersion }
				</h2>
				<div class="flex items-center gap-4">
					<label class="flex items-center gap-2 cursor-pointer">
						<input
							type="checkbox"
							id="show-parents-only"
							class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
							onchange="applyFilters()"
						/>
						<span class="text-sm text-gray-700">Show parents only</span>
					</label>
					<label class="flex items-center gap-2 cursor-pointer">
						<input
							type="checkbox"
							id="hide-completed"
							class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
							onchange="applyFilters()"
						/>
						<span class="text-sm text-gray-700">Hide completed work</span>
					</label>
				</div>
			</div>

			<script>
				function applyFilters() {
					const hideChildren = document.getElementById('show-parents-only').checked;
					const hideCompleted = document.getElementById('hide-completed').checked;

					const rows = document.querySelectorAll('tbody tr');
					let visibleCount = 0;
					rows.forEach(row => {
						const isChild = row.classList.contains('child-row');
						const isCompleted = row.dataset.completed === 'true';
						const hide = (hideChildren && isChild) || (hideCompleted && isCompleted);
						row.style.display = hide ? 'none' : '';
						if (!hide) visibleCount++;
					});
					document.getElementById('visible-issue-count').textContent = visibleCount;

					const cards = document.querySelectorAll('.mobile-card');
					cards.forEach(card => {
						const isChild = card.classList.contains('child-card');
						const isCompleted = card.dataset.completed === 'true';
						const hide = (hideChildren && isChild) || (hideCompleted && isCompleted);
						card.style.display = hide ? 'none' : '';
					});
				}
			</script>

			<!-- Desktop table view -->
			<div class="hidden md:block bg-white rounded-b-lg shadow-md overflow-hidden">
				<div class="overflow-x-auto">
					<table class="w-full divide-y divide-gray-200">
						<thead class="bg-gray-50">
							<tr>
								<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap">Key</th>
								<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap">Type</th>
								<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-full">Summary</th>
								<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap">Status</th>
								<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap">Project Charge</th>
								<th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap">Estimate</th>
								<th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap">Dev Time</th>
								<th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap">Remaining</th>
								<th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap min-w-[120px]">Progress</th>
							</tr>
						</thead>
						<tbody class="bg-white divide-y divide-gray-200">
							for _, group := range groupIssuesByParent(issues) {
								if group.Parent != nil {
									if len(group.Children) > 0 {
										@parentIssueRow(*group.Parent, calcGroupTotals(group))
									} else {
										@issueRow(*group.Parent, false)
									}
								}
								for _, child := range group.Children {
									@issueRow(child, true)
								}
							}
						</tbody>
					</table>
				</div>
			</div>

			<!-- Mobile card view -->
			<div class="md:hidden space-y-4">
				for _, group := range groupIssuesByParent(issues) {
					if group.Parent != nil {
						if len(group.Children) > 0 {
							@parentIssueCard(*group.Parent, calcGroupTotals(group))
						} else {
							@issueCard(*group.Parent, false)
						}
					}
					for _, child := range group.Children {
						@issueCard(child, true)
					}
				}
			</div>
		}
	}
}

templ issueRow(issue types.ProjectTimeTracking, isChild bool) {
	<tr class={ "hover:bg-gray-50", templ.KV("bg-red-50", issue.IsOverBudget()), templ.KV("bg-yellow-50", !issue.IsOverBudget() && (!issue.EstimateSeconds.Valid || issue.EstimateSeconds.Int32 == 0)), templ.KV("bg-gray-50/50", isChild && !issue.IsOverBudget() && issue.EstimateSeconds.Valid && issue.EstimateSeconds.Int32 > 0), templ.KV("child-row", isChild) } data-completed={ fmt.Sprintf("%t", !issue.StillWithDev()) }>
		<td class={ "px-4 py-3 text-sm whitespace-nowrap", templ.KV("pl-10", isChild) }>
			<a
				href={ templ.SafeURL("https://amagsymmetry.atlassian.net/browse/" + issue.Key) }
				target="_blank"
				class="text-blue-600 hover:text-blue-800 hover:underline font-medium"
			>
				{ issue.Key }
			</a>
		</td>
		<td class="px-4 py-3 text-sm text-gray-900 whitespace-nowrap">
			@issueTypeBadge(issue.Type)
		</td>
		<td class="px-4 py-3 text-sm text-gray-900" title={ issue.Summary }>
			{ issue.Summary }
		</td>
		<td class="px-4 py-3 text-sm whitespace-nowrap">
			@statusBadge(issue.Status)
		</td>
		<td class="px-4 py-3 text-sm text-gray-900 whitespace-nowrap">
			if issue.ProjectCharge != "" {
				<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
					{ issue.ProjectCharge }
				</span>
			}
		</td>
		<td class="px-4 py-3 text-sm text-gray-900 text-right font-mono whitespace-nowrap">
			if issue.EstimateSeconds.Valid && issue.EstimateSeconds.Int32 > 0 {
				{ formatSeconds(issue.EstimateSeconds.Int32) }
			} else {
				<span class="text-gray-400">-</span>
			}
		</td>
		<td class="px-4 py-3 text-sm text-right font-mono whitespace-nowrap">
			if issue.DevSeconds.Valid && issue.DevSeconds.Int32 > 0 {
				<span class={ templ.KV("text-red-600 font-semibold", issue.IsOverBudget()), templ.KV("text-gray-900", !issue.IsOverBudget()) }>
					{ formatSeconds(issue.DevSeconds.Int32) }
				</span>
			} else {
				<span class="text-gray-400">-</span>
			}
		</td>
		<td class="px-4 py-3 text-sm text-right font-mono whitespace-nowrap">
			if issue.RemainingSeconds.Valid && issue.RemainingSeconds.Int32 > 0 {
				{ formatSeconds(issue.RemainingSeconds.Int32) }
			} else {
				<span class="text-gray-400">-</span>
			}
		</td>
		<td class="px-4 py-3 text-sm min-w-[120px]">
			@progressBar(issue)
		</td>
	</tr>
}

templ issueCard(issue types.ProjectTimeTracking, isChild bool) {
	<div class={ "mobile-card rounded-lg shadow-md overflow-hidden", templ.KV("bg-red-50 border-l-4 border-red-500", issue.IsOverBudget()), templ.KV("bg-yellow-50 border-l-4 border-yellow-500", !issue.IsOverBudget() && (!issue.EstimateSeconds.Valid || issue.EstimateSeconds.Int32 == 0)), templ.KV("bg-white", !issue.IsOverBudget() && issue.EstimateSeconds.Valid && issue.EstimateSeconds.Int32 > 0), templ.KV("ml-6 border-l-4 border-gray-300", isChild && !issue.IsOverBudget() && issue.EstimateSeconds.Valid && issue.EstimateSeconds.Int32 > 0), templ.KV("child-card", isChild) } data-completed={ fmt.Sprintf("%t", !issue.StillWithDev()) }>
		<div class="px-4 py-3 bg-gray-50 border-b flex items-center justify-between">
			<a
				href={ templ.SafeURL("https://amagsymmetry.atlassian.net/browse/" + issue.Key) }
				target="_blank"
				class="text-blue-600 hover:text-blue-800 hover:underline font-semibold"
			>
				{ issue.Key }
			</a>
			@issueTypeBadge(issue.Type)
		</div>
		<div class="px-4 py-3">
			<p class="text-sm text-gray-900 mb-3">{ issue.Summary }</p>
			<div class="flex flex-wrap gap-2 items-center mb-3">
				@statusBadge(issue.Status)
				if issue.ProjectCharge != "" {
					<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
						{ issue.ProjectCharge }
					</span>
				}
			</div>
			<div class="grid grid-cols-3 gap-2 text-sm mb-2">
				<div>
					<span class="text-gray-500">Estimate:</span>
					<span class="font-mono ml-1">
						if issue.EstimateSeconds.Valid && issue.EstimateSeconds.Int32 > 0 {
							{ formatSeconds(issue.EstimateSeconds.Int32) }
						} else {
							-
						}
					</span>
				</div>
				<div>
					<span class="text-gray-500">Dev Time:</span>
					<span class={ "font-mono ml-1", templ.KV("text-red-600 font-semibold", issue.IsOverBudget()) }>
						if issue.DevSeconds.Valid && issue.DevSeconds.Int32 > 0 {
							{ formatSeconds(issue.DevSeconds.Int32) }
						} else {
							-
						}
					</span>
				</div>
				<div>
					<span class="text-gray-500">Remaining:</span>
					<span class="font-mono ml-1">
						if issue.RemainingSeconds.Valid && issue.RemainingSeconds.Int32 > 0 {
							{ formatSeconds(issue.RemainingSeconds.Int32) }
						} else {
							-
						}
					</span>
				</div>
			</div>
			@progressBar(issue)
		</div>
	</div>
}

templ parentIssueRow(issue types.ProjectTimeTracking, totals AggregatedTotals) {
	<tr class={ "hover:bg-gray-50 font-semibold", templ.KV("bg-red-50", totals.IsOverBudget()), templ.KV("bg-yellow-50", !totals.IsOverBudget() && totals.EstimateSeconds == 0), templ.KV("bg-blue-50/30", !totals.IsOverBudget() && totals.EstimateSeconds > 0) } data-completed={ fmt.Sprintf("%t", !issue.StillWithDev()) }>
		<td class="px-4 py-3 text-sm whitespace-nowrap">
			<a
				href={ templ.SafeURL("https://amagsymmetry.atlassian.net/browse/" + issue.Key) }
				target="_blank"
				class="text-blue-600 hover:text-blue-800 hover:underline font-medium"
			>
				{ issue.Key }
			</a>
		</td>
		<td class="px-4 py-3 text-sm text-gray-900 whitespace-nowrap">
			@issueTypeBadge(issue.Type)
		</td>
		<td class="px-4 py-3 text-sm text-gray-900" title={ issue.Summary }>
			{ issue.Summary }
		</td>
		<td class="px-4 py-3 text-sm whitespace-nowrap">
			@statusBadge(issue.Status)
		</td>
		<td class="px-4 py-3 text-sm text-gray-900 whitespace-nowrap">
			if issue.ProjectCharge != "" {
				<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
					{ issue.ProjectCharge }
				</span>
			}
		</td>
		<td class="px-4 py-3 text-sm text-gray-900 text-right font-mono whitespace-nowrap">
			if totals.EstimateSeconds > 0 {
				{ formatSeconds(totals.EstimateSeconds) }
			} else {
				<span class="text-gray-400">-</span>
			}
		</td>
		<td class="px-4 py-3 text-sm text-right font-mono whitespace-nowrap">
			if totals.DevSeconds > 0 {
				<span class={ templ.KV("text-red-600 font-semibold", totals.IsOverBudget()), templ.KV("text-gray-900", !totals.IsOverBudget()) }>
					{ formatSeconds(totals.DevSeconds) }
				</span>
			} else {
				<span class="text-gray-400">-</span>
			}
		</td>
		<td class="px-4 py-3 text-sm text-right font-mono whitespace-nowrap">
			if   totals.JiraRemainingSeconds > 0 {
				{ formatSeconds(totals.JiraRemainingSeconds) }
			} else {
				<span class="text-gray-400">-</span>
			}
		</td>
		<td class="px-4 py-3 text-sm min-w-[120px]">
			@aggregatedProgressBar(totals)
		</td>
	</tr>
}

templ parentIssueCard(issue types.ProjectTimeTracking, totals AggregatedTotals) {
	<div class={ "mobile-card rounded-lg shadow-md overflow-hidden border-l-4", templ.KV("bg-red-50 border-red-500", totals.IsOverBudget()), templ.KV("bg-yellow-50 border-yellow-500", !totals.IsOverBudget() && totals.EstimateSeconds == 0), templ.KV("bg-white border-blue-500", !totals.IsOverBudget() && totals.EstimateSeconds > 0) } data-completed={ fmt.Sprintf("%t", !issue.StillWithDev()) }>
		<div class="px-4 py-3 bg-blue-50 border-b flex items-center justify-between">
			<a
				href={ templ.SafeURL("https://amagsymmetry.atlassian.net/browse/" + issue.Key) }
				target="_blank"
				class="text-blue-600 hover:text-blue-800 hover:underline font-semibold"
			>
				{ issue.Key }
			</a>
			@issueTypeBadge(issue.Type)
		</div>
		<div class="px-4 py-3">
			<p class="text-sm text-gray-900 font-semibold mb-3">{ issue.Summary }</p>
			<div class="flex flex-wrap gap-2 items-center mb-3">
				@statusBadge(issue.Status)
				if issue.ProjectCharge != "" {
					<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
						{ issue.ProjectCharge }
					</span>
				}
			</div>
			<div class="grid grid-cols-3 gap-2 text-sm mb-2">
				<div>
					<span class="text-gray-500">Total Estimate:</span>
					<span class="font-mono font-semibold ml-1">
						if totals.EstimateSeconds > 0 {
							{ formatSeconds(totals.EstimateSeconds) }
						} else {
							-
						}
					</span>
				</div>
				<div>
					<span class="text-gray-500">Total Dev Time:</span>
					<span class={ "font-mono font-semibold ml-1", templ.KV("text-red-600", totals.IsOverBudget()) }>
						if totals.DevSeconds > 0 {
							{ formatSeconds(totals.DevSeconds) }
						} else {
							-
						}
					</span>
				</div>
				<div>
					<span class="text-gray-500">Dev Remaining:</span>
					<span class="font-mono font-semibold ml-1">
						if totals.RemainingDevSeconds() > 0 {
							{ formatSeconds(totals.RemainingDevSeconds()) }
						} else {
							-
						}
					</span>
				</div>
				<div>
					<span class="text-gray-500">Jira Remaining:</span>
					<span class="font-mono font-semibold ml-1">
						if totals.JiraRemainingSeconds > 0 {
							{ formatSeconds(totals.JiraRemainingSeconds) }
						} else {
							-
						}
					</span>
				</div>
			</div>
			@aggregatedProgressBar(totals)
		</div>
	</div>
}

templ aggregatedProgressBar(totals AggregatedTotals) {
	if totals.EstimateSeconds == 0 {
		<div class="text-xs text-gray-400">No estimate</div>
	} else {
		<div class="flex items-center gap-2">
			<div class="flex-grow bg-gray-200 rounded-full h-2 overflow-hidden">
				<div
					class={ "h-2 rounded-full", progressBarColor(totals.Progress()) }
					style={ fmt.Sprintf("width: %.0f%%", min(totals.Progress(), 100)) }
				></div>
			</div>
			<span class={ "text-xs font-medium w-12 text-right", progressTextColor(totals.Progress()) }>
				{ fmt.Sprintf("%.0f%%", totals.Progress()) }
			</span>
		</div>
	}
}

templ timeTrackingSummary(issues []types.ProjectTimeTracking) {
	{{ summary := summaryWidgets(issues) }}
	<!-- Total Issues -->
	<div class="bg-white rounded-lg shadow-md p-4">
		<div class="text-sm text-gray-500">Total Issues</div>
		<div class="text-2xl font-bold text-gray-900">{ fmt.Sprintf("%d", summary.TotalIssues) }</div>
	</div>

	<!-- Total Estimated -->
	<div class="bg-white rounded-lg shadow-md p-4">
		<div class="text-sm text-gray-500">Total Estimated</div>
		<div class="text-2xl font-bold text-blue-600">{ formatSeconds(summary.EstimateTotal) }</div>
		<div class="text-xl font-bold text-blue-600">{ formatSecondsToHours(summary.EstimateTotal) }h</div>
	</div>

	<!-- Total Dev Time -->
	<div class="bg-white rounded-lg shadow-md p-4">
		<div class="text-sm text-gray-500">Total Dev Time</div>
		<div class="text-2xl font-bold text-green-600">{ formatSeconds(summary.DevTimeTotal) }</div>
		<div class="text-xl font-bold text-green-600">{ formatSecondsToHours(summary.DevTimeTotal) }h</div>
	</div>

	<!-- Remaining Dev Time -->
	<div class="bg-white rounded-lg shadow-md p-4">
		<div class="text-sm text-gray-500">Remaining Dev Time</div>
		<div class="text-2xl font-bold text-orange-600">{ formatSeconds(summary.RemainingTimeTotal) }</div>
		<div class="text-xl font-bold text-orange-600">{ formatSecondsToHours(summary.RemainingTimeTotal) }h</div>
	</div>

	<!-- Remaining Jira Time -->
	<div class="bg-white rounded-lg shadow-md p-4">
		<div class="text-sm text-gray-500">Remaining Jira Time</div>
		<div class="text-2xl font-bold text-orange-600">{ formatSeconds(summary.JiraRemainingTimeTotal) }</div>
		<div class="text-xl font-bold text-orange-600">{ formatSecondsToHours(summary.JiraRemainingTimeTotal) }h</div>
	</div>

	<!-- Over Budget Count -->
	<div class="bg-white rounded-lg shadow-md p-4">
		<div class="text-sm text-gray-500">Over Budget</div>
		<div class={ "text-2xl font-bold", overBudgetColor(summary.IssuesOverBudget) }>{ fmt.Sprintf("%d", summary.IssuesOverBudget) }</div>
	</div>
}

templ progressBar(issue types.ProjectTimeTracking) {
	if !issue.EstimateSeconds.Valid || issue.EstimateSeconds.Int32 == 0 {
		<div class="text-xs text-gray-400">No estimate</div>
	} else {
		<div class="flex items-center gap-2">
			<div class="flex-grow bg-gray-200 rounded-full h-2 overflow-hidden">
				<div
					class={ "h-2 rounded-full", progressBarColor(issue.Progress()) }
					style={ fmt.Sprintf("width: %.0f%%", min(issue.Progress(), 100)) }
				></div>
			</div>
			<span class={ "text-xs font-medium w-12 text-right", progressTextColor(issue.Progress()) }>
				{ fmt.Sprintf("%.0f%%", issue.Progress()) }
			</span>
		</div>
	}
}

templ issueTypeBadge(issueType string) {
	switch issueType {
		case "Story":
			<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
				{ issueType }
			</span>
		case "Bug", "Customer Bug":
			<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">
				{ issueType }
			</span>
		case "Task", "Sub-task":
			<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
				{ issueType }
			</span>
		default:
			<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
				{ issueType }
			</span>
	}
}

// Helper functions

// calcGroupTotals calculates the aggregated estimate and dev time for a parent + all its children
func calcGroupTotals(group IssueGroup) AggregatedTotals {
	var totals AggregatedTotals

	// Add parent's values
	if group.Parent != nil {
		if group.Parent.EstimateSeconds.Valid {
			totals.EstimateSeconds += group.Parent.EstimateSeconds.Int32
		}
		if group.Parent.DevSeconds.Valid {
			totals.DevSeconds += group.Parent.DevSeconds.Int32
		}
		if group.Parent.RemainingSeconds.Valid {
			totals.JiraRemainingSeconds += group.Parent.RemainingSeconds.Int32
		}
	}

	// Add children's values
	for _, child := range group.Children {
		if child.EstimateSeconds.Valid {
			totals.EstimateSeconds += child.EstimateSeconds.Int32
		}
		if child.DevSeconds.Valid {
			totals.DevSeconds += child.DevSeconds.Int32
		}
		if child.RemainingSeconds.Valid {
			totals.JiraRemainingSeconds += child.RemainingSeconds.Int32
		}
	}

	return totals
}

// groupIssuesByParent organizes issues so parents come first followed by their children
func groupIssuesByParent(issues []types.ProjectTimeTracking) []IssueGroup {
	// Build a map of ID -> issue for quick lookup
	issueMap := make(map[int]*types.ProjectTimeTracking)
	for i := range issues {
		issueMap[issues[i].ID] = &issues[i]
	}

	// Build a map of parentID -> children
	childrenMap := make(map[int][]types.ProjectTimeTracking)

	// Track which issues are children (have a parent in the result set)
	isChildOfParentInSet := make(map[int]bool)

	for _, issue := range issues {
		if issue.ParentID.Valid {
			parentID := int(issue.ParentID.Int32)
			childrenMap[parentID] = append(childrenMap[parentID], issue)
			// Mark as child if parent exists in our result set
			if _, exists := issueMap[parentID]; exists {
				isChildOfParentInSet[issue.ID] = true
			}
		}
	}

	// Build the result groups - only add issues that aren't children of another issue in the set
	var groups []IssueGroup
	processedIssues := make(map[int]bool)

	for _, issue := range issues {
		// Skip if this issue is a child of another issue in the result set
		if isChildOfParentInSet[issue.ID] {
			continue
		}
		// Skip if already processed
		if processedIssues[issue.ID] {
			continue
		}

		group := IssueGroup{
			Parent:   &issue,
			Children: childrenMap[issue.ID],
		}
		processedIssues[issue.ID] = true
		for _, child := range group.Children {
			processedIssues[child.ID] = true
		}

		group.Totals = calcGroupTotals(group)
		groups = append(groups, group)
	}

	return groups
}

// formatSeconds converts seconds to a friendly format like "1w 2d 4h 45m"
// Only shows non-zero values. Uses 7.5 hours per day (450 minutes), 5 days per week.
func formatSeconds(seconds int32) string {
	if seconds <= 0 {
		return "-"
	}

	const minutesPerDay = 450  // 7.5 hours * 60 minutes
	const minutesPerWeek = 450 * 5

	totalMinutes := int(seconds) / 60

	weeks := totalMinutes / minutesPerWeek
	remaining := totalMinutes % minutesPerWeek

	days := remaining / minutesPerDay
	remaining = remaining % minutesPerDay

	hours := remaining / 60
	minutes := remaining % 60

	var parts []string
	if weeks > 0 {
		parts = append(parts, fmt.Sprintf("%dw", weeks))
	}
	if days > 0 {
		parts = append(parts, fmt.Sprintf("%dd", days))
	}
	if hours > 0 {
		parts = append(parts, fmt.Sprintf("%dh", hours))
	}
	if minutes > 0 {
		parts = append(parts, fmt.Sprintf("%dm", minutes))
	}

	if len(parts) == 0 {
		return "-"
	}

	result := ""
	for i, part := range parts {
		if i > 0 {
			result += " "
		}
		result += part
	}
	return result
}

func formatSecondsToHours(seconds int32) int {
	if seconds <= 0 {
		return 0
	}
	return int(seconds) / 60 / 60
}


func summaryWidgets(issues []types.ProjectTimeTracking) SummaryWidget {
	summary := SummaryWidget{
		TotalIssues: len(issues),
	}
	for _, issue := range issues {
		if issue.EstimateSeconds.Valid {
			summary.EstimateTotal += issue.EstimateSeconds.Int32
		}
		if issue.DevSeconds.Valid {
			summary.DevTimeTotal += issue.DevSeconds.Int32
		}
		if issue.IsOverBudget() {
			summary.IssuesOverBudget++
		}
	}

	groups := groupIssuesByParent(issues)
	for _, group := range groups {
		if group.Parent.StillWithDev() {
			summary.JiraRemainingTimeTotal += group.Totals.JiraRemainingSeconds
			summary.RemainingTimeTotal += group.Totals.RemainingDevSeconds()
		}
	}
	return summary
}

