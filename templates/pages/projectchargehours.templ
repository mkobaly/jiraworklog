package pages

import (
	"fmt"
	"sort"
	"strings"

	"github.com/mkobaly/jiraworklog/templates/layouts"
	"github.com/mkobaly/jiraworklog/types"
)

// ProjectGroup represents a project with its charges and total hours
type ProjectGroup struct {
	Name    string
	Charges []ChargeGroup
	Total   float64
}

// ChargeGroup represents a project charge with detail rows
type ChargeGroup struct {
	Name       string
	DetailRows []DetailRow
	Total      float64
}

// DetailRow represents a row with optional grouping dimensions
type DetailRow struct {
	YearMonth     string
	IsEmployee    bool
	Role          string
	ProjectCharge string
	Location      string
	Hours         float64
}

// GroupingOptions holds the current grouping settings
type GroupingOptions struct {
	ByDate     bool
	ByEmployee bool
	ByRole     bool
	ByCharge   bool
	ByLocation bool
}

func groupProjectChargeHours(data []types.ProjectChargeHours, opts GroupingOptions) []ProjectGroup {
	projectMap := make(map[string]*ProjectGroup)
	chargeMap := make(map[string]map[string]*ChargeGroup)
	// Use a map to aggregate detail rows by their grouping key
	detailMap := make(map[string]map[string]map[string]*DetailRow)
	var projectOrder []string

	for _, item := range data {
		// Initialize project if needed
		if _, exists := projectMap[item.Project]; !exists {
			projectMap[item.Project] = &ProjectGroup{Name: item.Project}
			chargeMap[item.Project] = make(map[string]*ChargeGroup)
			detailMap[item.Project] = make(map[string]map[string]*DetailRow)
			projectOrder = append(projectOrder, item.Project)
		}

		// Determine charge group name based on ByCharge option
		chargeGroupName := item.ProjectCharge
		if !opts.ByCharge {
			chargeGroupName = "All Project Charges"
		}

		// Initialize charge if needed
		if _, exists := chargeMap[item.Project][chargeGroupName]; !exists {
			chargeMap[item.Project][chargeGroupName] = &ChargeGroup{Name: chargeGroupName}
			detailMap[item.Project][chargeGroupName] = make(map[string]*DetailRow)
		}

		// Build grouping key based on options
		role := "Unknown"
		if item.Role.Valid && item.Role.String != "" {
			role = item.Role.String
		}

		location := "Unknown"
		if item.Location.Valid && item.Location.String != "" {
			location = item.Location.String
		}

		var keyParts []string
		yearMonth := ""
		if opts.ByDate {
			yearMonth = item.YearMonth
			keyParts = append(keyParts, item.YearMonth)
		}
		isEmployee := item.IsEmployee
		if opts.ByEmployee {
			keyParts = append(keyParts, fmt.Sprintf("%t", item.IsEmployee))
		}
		if opts.ByRole {
			keyParts = append(keyParts, role)
		}
		projectCharge := ""
		if opts.ByCharge {
			projectCharge = item.ProjectCharge
			keyParts = append(keyParts, item.ProjectCharge)
		}
		if opts.ByLocation {
			keyParts = append(keyParts, location)
		}

		key := strings.Join(keyParts, "|")
		if key == "" {
			key = "all"
		}

		// Aggregate hours for this key
		if existing, exists := detailMap[item.Project][chargeGroupName][key]; exists {
			existing.Hours += item.Hours
		} else {
			detailMap[item.Project][chargeGroupName][key] = &DetailRow{
				YearMonth:     yearMonth,
				IsEmployee:    isEmployee,
				Role:          role,
				ProjectCharge: projectCharge,
				Location:      location,
				Hours:         item.Hours,
			}
		}

		chargeMap[item.Project][chargeGroupName].Total += item.Hours
		projectMap[item.Project].Total += item.Hours
	}

	// Build final result maintaining order
	var result []ProjectGroup
	for _, projectName := range projectOrder {
		project := projectMap[projectName]
		for chargeName, charge := range chargeMap[projectName] {
			_ = chargeName
			// Convert detail map to slice and sort
			var details []DetailRow
			for _, detail := range detailMap[projectName][charge.Name] {
				details = append(details, *detail)
			}
			// Sort by yearmonth, then employee status, then role, then location
			sort.Slice(details, func(i, j int) bool {
				if details[i].YearMonth != details[j].YearMonth {
					return details[i].YearMonth < details[j].YearMonth
				}
				if details[i].ProjectCharge != details[j].ProjectCharge {
					return details[i].ProjectCharge < details[j].ProjectCharge
				}
				if details[i].IsEmployee != details[j].IsEmployee {
					return details[i].IsEmployee // employees first
				}
				if details[i].Role != details[j].Role {
					return details[i].Role < details[j].Role
				}
				return details[i].Location < details[j].Location
			})
			charge.DetailRows = details
			project.Charges = append(project.Charges, *charge)
		}
		result = append(result, *project)
	}

	return result
}

templ ProjectChargeHoursPage(data []types.ProjectChargeHours, groupByDate bool, groupByEmployee bool, groupByRole bool, groupByCharge bool, groupByLocation bool) {
	@layouts.Base("Project Charge Hours") {
		<div class="mb-6">
			<h1 class="text-3xl font-bold text-gray-900">Project Charge Hours</h1>
			<p class="text-gray-600 mt-2">Hours worked per project charge</p>
		</div>

		<!-- Grouping Options -->
		<div class="mb-6 bg-white rounded-lg shadow-md p-4">
			<div class="flex flex-wrap items-center justify-between gap-4">
				<div class="flex flex-wrap items-center gap-6">
					<span class="text-sm font-medium text-gray-700">Group by:</span>
					<label class="flex items-center cursor-pointer">
						<input
							type="checkbox"
							id="groupByDate"
							class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
							onchange="applyGrouping()"
							if groupByDate {
								checked
							}
						/>
						<span class="ml-2 text-sm text-gray-700">Month</span>
					</label>
					<label class="flex items-center cursor-pointer">
						<input
							type="checkbox"
							id="groupByCharge"
							class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
							onchange="applyGrouping()"
							if groupByCharge {
								checked
							}
						/>
						<span class="ml-2 text-sm text-gray-700">Project Charge</span>
					</label>
					<label class="flex items-center cursor-pointer">
						<input
							type="checkbox"
							id="groupByEmployee"
							class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
							onchange="applyGrouping()"
							if groupByEmployee {
								checked
							}
						/>
						<span class="ml-2 text-sm text-gray-700">Employee Type</span>
					</label>
					<label class="flex items-center cursor-pointer">
						<input
							type="checkbox"
							id="groupByRole"
							class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
							onchange="applyGrouping()"
							if groupByRole {
								checked
							}
						/>
						<span class="ml-2 text-sm text-gray-700">Role</span>
					</label>
					<label class="flex items-center cursor-pointer">
						<input
							type="checkbox"
							id="groupByLocation"
							class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
							onchange="applyGrouping()"
							if groupByLocation {
								checked
							}
						/>
						<span class="ml-2 text-sm text-gray-700">Location</span>
					</label>
				</div>
				<button
					onclick="exportCSV()"
					class="inline-flex items-center px-3 py-2 text-sm font-medium text-white bg-green-600 rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500"
				>
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
					</svg>
					Export CSV
				</button>
			</div>
		</div>

		<script>
			function applyGrouping() {
				const groupByDate = document.getElementById('groupByDate').checked;
				const groupByCharge = document.getElementById('groupByCharge').checked;
				const groupByEmployee = document.getElementById('groupByEmployee').checked;
				const groupByRole = document.getElementById('groupByRole').checked;
				const groupByLocation = document.getElementById('groupByLocation').checked;

				const params = new URLSearchParams();
				if (groupByDate) params.set('groupByDate', 'true');
				if (!groupByCharge) params.set('groupByCharge', 'false');
				if (groupByEmployee) params.set('groupByEmployee', 'true');
				if (!groupByRole) params.set('groupByRole', 'false');
				if (groupByLocation) params.set('groupByLocation', 'true');

				const queryString = params.toString();
				window.location.href = '/reports/project-hours' + (queryString ? '?' + queryString : '');
			}

			function exportCSV() {
				const groupByDate = document.getElementById('groupByDate').checked;
				const groupByCharge = document.getElementById('groupByCharge').checked;
				const groupByEmployee = document.getElementById('groupByEmployee').checked;
				const groupByRole = document.getElementById('groupByRole').checked;
				const groupByLocation = document.getElementById('groupByLocation').checked;

				const params = new URLSearchParams();
				if (groupByDate) params.set('groupByDate', 'true');
				if (!groupByCharge) params.set('groupByCharge', 'false');
				if (groupByEmployee) params.set('groupByEmployee', 'true');
				if (!groupByRole) params.set('groupByRole', 'false');
				if (groupByLocation) params.set('groupByLocation', 'true');

				const queryString = params.toString();
				window.location.href = '/reports/project-hours/csv' + (queryString ? '?' + queryString : '');
			}
		</script>

		if len(data) == 0 {
			<div class="bg-yellow-50 border-l-4 border-yellow-400 p-4">
				<p class="text-yellow-700">No project charge hours data found.</p>
			</div>
		} else {
			<!-- Desktop view -->
			<div class="hidden md:block space-y-6">
				for _, project := range groupProjectChargeHours(data, GroupingOptions{ByDate: groupByDate, ByEmployee: groupByEmployee, ByRole: groupByRole, ByCharge: groupByCharge, ByLocation: groupByLocation}) {
					<div class="bg-white rounded-lg shadow-md overflow-hidden">
						<!-- Project header -->
						<div class="bg-blue-600 text-white px-6 py-3 flex justify-between items-center">
							<h2 class="text-lg font-semibold">{ project.Name }</h2>
							<span class="text-lg font-bold">{ formatHours(project.Total) } hrs</span>
						</div>

						<table class="min-w-full divide-y divide-gray-200">
							<thead class="bg-gray-50">
								<tr>
									<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Project Charge</th>
									if groupByDate {
										<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Month</th>
									}
									if groupByEmployee {
										<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Employee</th>
									}
									if groupByRole {
										<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role</th>
									}
									if groupByLocation {
										<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Location</th>
									}
									<th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Hours</th>
								</tr>
							</thead>
							<tbody class="bg-white divide-y divide-gray-200">
								for _, charge := range project.Charges {
									for i, detail := range charge.DetailRows {
										<tr class="hover:bg-gray-50">
											if i == 0 {
												<td class="px-6 py-3 whitespace-nowrap" rowspan={ fmt.Sprintf("%d", len(charge.DetailRows)) }>
													<div class="text-sm font-medium text-gray-900">{ charge.Name }</div>
													<div class="text-xs text-gray-500">Subtotal: { formatHours(charge.Total) } hrs</div>
												</td>
											}
											if groupByDate {
												<td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900">
													{ detail.YearMonth }
												</td>
											}
											if groupByEmployee {
												<td class="px-6 py-3 whitespace-nowrap">
													@employeeBadge(detail.IsEmployee)
												</td>
											}
											if groupByRole {
												<td class="px-6 py-3 whitespace-nowrap">
													@roleBadge(detail.Role)
												</td>
											}
											if groupByLocation {
												<td class="px-6 py-3 whitespace-nowrap">
													@locationBadge(detail.Location)
												</td>
											}
											<td class="px-6 py-3 whitespace-nowrap text-right text-sm text-gray-900">
												{ formatHours(detail.Hours) }
											</td>
										</tr>
									}
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			<!-- Mobile view -->
			<div class="md:hidden space-y-4">
				for _, project := range groupProjectChargeHours(data, GroupingOptions{ByDate: groupByDate, ByEmployee: groupByEmployee, ByRole: groupByRole, ByCharge: groupByCharge, ByLocation: groupByLocation}) {
					<div class="bg-white rounded-lg shadow-md overflow-hidden">
						<!-- Project header -->
						<div class="bg-blue-600 text-white px-4 py-3 flex justify-between items-center">
							<h2 class="text-base font-semibold">{ project.Name }</h2>
							<span class="text-base font-bold">{ formatHours(project.Total) } hrs</span>
						</div>

						<div class="divide-y divide-gray-200">
							for _, charge := range project.Charges {
								<div class="p-4">
									<div class="flex justify-between items-start mb-2">
										<span class="text-sm font-medium text-gray-900">{ charge.Name }</span>
										<span class="text-sm font-semibold text-blue-600">{ formatHours(charge.Total) } hrs</span>
									</div>
									<div class="space-y-2">
										for _, detail := range charge.DetailRows {
											<div class="flex flex-wrap justify-between items-center text-sm gap-1">
												<div class="flex flex-wrap items-center gap-2">
													if groupByDate {
														<span class="text-xs text-gray-500">{ detail.YearMonth }</span>
													}
													if groupByEmployee {
														@employeeBadge(detail.IsEmployee)
													}
													if groupByRole {
														@roleBadge(detail.Role)
													}
													if groupByLocation {
														@locationBadge(detail.Location)
													}
												</div>
												<span class="text-gray-700">{ formatHours(detail.Hours) } hrs</span>
											</div>
										}
									</div>
								</div>
							}
						</div>
					</div>
				}
			</div>

			<!-- Summary stats -->
			<div class="mt-6 bg-white rounded-lg shadow-md p-6">
				<h3 class="text-lg font-semibold text-gray-900 mb-4">Summary</h3>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
					<div class="bg-blue-50 rounded-lg p-4">
						<div class="text-sm text-blue-600 font-medium">Total Projects</div>
						<div class="text-2xl font-bold text-blue-900">{ fmt.Sprintf("%d", countUniqueProjects(data)) }</div>
					</div>
					<div class="bg-green-50 rounded-lg p-4">
						<div class="text-sm text-green-600 font-medium">Total Hours</div>
						<div class="text-2xl font-bold text-green-900">{ formatHours(totalHours(data)) }</div>
					</div>
					<div class="bg-purple-50 rounded-lg p-4">
						<div class="text-sm text-purple-600 font-medium">Project Charges</div>
						<div class="text-2xl font-bold text-purple-900">{ fmt.Sprintf("%d", countUniqueCharges(data)) }</div>
					</div>
				</div>
			</div>
		}
	}
}

templ roleBadge(role string) {
	switch role {
		case "dev":
			<span class="px-2 py-1 text-xs rounded-full bg-blue-100 text-blue-800">dev</span>
		case "qa":
			<span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-800">qa</span>
		case "devOps":
			<span class="px-2 py-1 text-xs rounded-full bg-purple-100 text-purple-800">devOps</span>
		case "mgmt":
			<span class="px-2 py-1 text-xs rounded-full bg-orange-100 text-orange-800">mgmt</span>
		default:
			<span class="px-2 py-1 text-xs rounded-full bg-gray-100 text-gray-800">{ role }</span>
	}
}

templ employeeBadge(isEmployee bool) {
	if isEmployee {
		<span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-800">Employee</span>
	} else {
		<span class="px-2 py-1 text-xs rounded-full bg-yellow-100 text-yellow-800">Contractor</span>
	}
}

templ locationBadge(location string) {
	if location == "" || location == "Unknown" {
		<span class="px-2 py-1 text-xs rounded-full bg-gray-100 text-gray-800">Unknown</span>
	} else {
		<span class="px-2 py-1 text-xs rounded-full bg-indigo-100 text-indigo-800">{ location }</span>
	}
}

func countUniqueProjects(data []types.ProjectChargeHours) int {
	projects := make(map[string]bool)
	for _, item := range data {
		projects[item.Project] = true
	}
	return len(projects)
}

func totalHours(data []types.ProjectChargeHours) float64 {
	var total float64
	for _, item := range data {
		total += item.Hours
	}
	return total
}

func countUniqueCharges(data []types.ProjectChargeHours) int {
	charges := make(map[string]bool)
	for _, item := range data {
		charges[item.ProjectCharge] = true
	}
	return len(charges)
}

// formatHours formats a float with commas as thousands separator
func formatHours(n float64) string {
	// Format with 2 decimal places first
	s := fmt.Sprintf("%.2f", n)

	// Split into integer and decimal parts
	parts := strings.Split(s, ".")
	intPart := parts[0]
	decPart := parts[1]

	// Add commas to integer part
	var result strings.Builder
	negative := false
	if len(intPart) > 0 && intPart[0] == '-' {
		negative = true
		intPart = intPart[1:]
	}

	for i, c := range intPart {
		if i > 0 && (len(intPart)-i)%3 == 0 {
			result.WriteRune(',')
		}
		result.WriteRune(c)
	}

	formatted := result.String()
	if negative {
		formatted = "-" + formatted
	}

	return formatted + "." + decPart
}
