package pages

import (
	"fmt"
	"sort"
	"strings"

	"github.com/mkobaly/jiraworklog/templates/layouts"
	"github.com/mkobaly/jiraworklog/types"
	"slices"
)

// ProjectGroup represents a project with its charges and total hours
type ProjectGroup struct {
	Name    string
	Charges []ChargeGroup
	Total   float64
}

// ChargeGroup represents a project charge with detail rows
type ChargeGroup struct {
	Name       string
	Category   string
	Type       string
	DetailRows []DetailRow
	Total      float64
}

// DetailRow represents a row with optional grouping dimensions
type DetailRow struct {
	YearMonth     string
	IsEmployee    bool
	Role          string
	ProjectCharge string
	Location      string
	Hours         float64
}

// GroupingOptions holds the current grouping settings
type GroupingOptions struct {
	// ParentBy selects the top-level (parent) grouping dimension:
	// "label" (default), "category", or "type".
	ParentBy   string
	ByDate     bool
	ByEmployee bool
	ByRole     bool
	ByCharge   bool
	ByLocation bool
}

// parentKey returns the top-level grouping key for an item based on the
// selected parent dimension. Defaults to the project charge Label.
func parentKey(item types.ProjectChargeHours, by string) string {
	switch by {
	case "category":
		return item.Category()
	case "type":
		return item.Type()
	default:
		return item.Label
	}
}

// ChargeFilterState holds active filter selections and available options
type ChargeFilterState struct {
	FromMonth    string
	ToMonth      string
	Charges      []string
	Roles        []string
	Locations    []string
	EmpTypes     []string
	AllCharges   []string
	AllRoles     []string
	AllLocations []string
}

func groupProjectChargeHours(data []types.ProjectChargeHours, opts GroupingOptions) []ProjectGroup {
	projectMap := make(map[string]*ProjectGroup)
	chargeMap := make(map[string]map[string]*ChargeGroup)
	// Use a map to aggregate detail rows by their grouping key
	detailMap := make(map[string]map[string]map[string]*DetailRow)
	var projectOrder []string

	for _, item := range data {
		// Parent (top-level) group key — Label, Category, or Type per opts.
		pkey := parentKey(item, opts.ParentBy)

		// Initialize parent group if needed
		if _, exists := projectMap[pkey]; !exists {
			projectMap[pkey] = &ProjectGroup{Name: pkey}
			chargeMap[pkey] = make(map[string]*ChargeGroup)
			detailMap[pkey] = make(map[string]map[string]*DetailRow)
			projectOrder = append(projectOrder, pkey)
		}

		// Determine charge group name based on ByCharge option
		chargeGroupName := item.ProjectCharge
		if !opts.ByCharge {
			chargeGroupName = "All Project Charges"
		}

		// Initialize charge if needed
		if _, exists := chargeMap[pkey][chargeGroupName]; !exists {
			category, chargeType := "", ""
			if opts.ByCharge {
				category = item.Category()
				chargeType = item.Type()
			}
			chargeMap[pkey][chargeGroupName] = &ChargeGroup{Name: chargeGroupName, Category: category, Type: chargeType}
			detailMap[pkey][chargeGroupName] = make(map[string]*DetailRow)
		}

		// Build grouping key based on options
		role := "Unknown"
		if item.Role.Valid && item.Role.String != "" {
			role = item.Role.String
		}

		location := "Unknown"
		if item.Location.Valid && item.Location.String != "" {
			location = item.Location.String
		}

		var keyParts []string
		yearMonth := ""
		if opts.ByDate {
			yearMonth = item.YearMonth
			keyParts = append(keyParts, item.YearMonth)
		}
		isEmployee := item.IsEmployee
		if opts.ByEmployee {
			keyParts = append(keyParts, fmt.Sprintf("%t", item.IsEmployee))
		}
		if opts.ByRole {
			keyParts = append(keyParts, role)
		}
		projectCharge := ""
		if opts.ByCharge {
			projectCharge = item.ProjectCharge
			keyParts = append(keyParts, item.ProjectCharge)
		}
		if opts.ByLocation {
			keyParts = append(keyParts, location)
		}

		key := strings.Join(keyParts, "|")
		if key == "" {
			key = "all"
		}

		// Aggregate hours for this key
		if existing, exists := detailMap[pkey][chargeGroupName][key]; exists {
			existing.Hours += item.Hours
		} else {
			detailMap[pkey][chargeGroupName][key] = &DetailRow{
				YearMonth:     yearMonth,
				IsEmployee:    isEmployee,
				Role:          role,
				ProjectCharge: projectCharge,
				Location:      location,
				Hours:         item.Hours,
			}
		}

		chargeMap[pkey][chargeGroupName].Total += item.Hours
		projectMap[pkey].Total += item.Hours
	}

	// Build final result maintaining order
	var result []ProjectGroup
	for _, projectName := range projectOrder {
		project := projectMap[projectName]
		for chargeName, charge := range chargeMap[projectName] {
			_ = chargeName
			// Convert detail map to slice and sort
			var details []DetailRow
			for _, detail := range detailMap[projectName][charge.Name] {
				details = append(details, *detail)
			}
			// Sort by yearmonth, then employee status, then role, then location
			sort.Slice(details, func(i, j int) bool {
				if details[i].YearMonth != details[j].YearMonth {
					return details[i].YearMonth < details[j].YearMonth
				}
				if details[i].ProjectCharge != details[j].ProjectCharge {
					return details[i].ProjectCharge < details[j].ProjectCharge
				}
				if details[i].IsEmployee != details[j].IsEmployee {
					return details[i].IsEmployee // employees first
				}
				if details[i].Role != details[j].Role {
					return details[i].Role < details[j].Role
				}
				return details[i].Location < details[j].Location
			})
			charge.DetailRows = details
			project.Charges = append(project.Charges, *charge)
		}
		// Charges were collected from a map (random iteration order), so sort
		// them deterministically to avoid the order jumping on each refresh.
		slices.SortFunc(project.Charges, func(a, b ChargeGroup) int {
			return strings.Compare(a.Name, b.Name)
		})
		result = append(result, *project)
	}

	slices.SortFunc(result, func(a, b ProjectGroup) int {
		return  strings.Compare(a.Name, b.Name)
	})
	return result
}

templ ProjectChargeHoursPage(data []types.ProjectChargeHours, filters ChargeFilterState, opts GroupingOptions) {
	@layouts.Base("Project Charge Hours") {
		<div class="mb-6">
			<h1 class="text-3xl font-bold text-gray-900">Project Charge Hours</h1>
			<p class="text-gray-600 mt-2">Hours worked per project charge</p>
		</div>

		<!-- Unified filter + grouping form -->
		<form id="filterForm" method="GET" action="/reports/project-hours" class="mb-6 space-y-4">
			<!-- sentinel so handler knows a form was submitted (vs. initial page load defaults) -->
			<input type="hidden" name="_f" value="1"/>

			<!-- Date range + grouping row -->
			<div class="bg-white rounded-lg shadow-md p-4 space-y-4">
				<!-- Row 1: date range + top-level grouping -->
				<div class="flex flex-wrap items-center gap-6">
					<!-- Date range -->
					<div class="flex items-center gap-2">
						<label class="text-sm font-medium text-gray-700 whitespace-nowrap">From:</label>
						<input
							type="month"
							name="from"
							value={ filters.FromMonth }
							class="border border-gray-300 rounded-md px-2 py-1 text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500"
						/>
					</div>
					<div class="flex items-center gap-2">
						<label class="text-sm font-medium text-gray-700 whitespace-nowrap">Through:</label>
						<input
							type="month"
							name="to"
							value={ filters.ToMonth }
							class="border border-gray-300 rounded-md px-2 py-1 text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500"
						/>
					</div>

					<div class="w-px h-6 bg-gray-200"></div>

					<!-- Top-level (parent) grouping -->
					<div class="flex items-center gap-2">
						<label class="text-sm font-medium text-gray-700 whitespace-nowrap">Group by:</label>
						<select name="groupBy" onchange="this.form.submit()" class="border border-gray-300 rounded-md px-2 py-1 text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500">
							<option value="label" if opts.ParentBy == "label" { selected }>Project</option>
							<option value="category" if opts.ParentBy == "category" { selected }>Category</option>
							<option value="type" if opts.ParentBy == "type" { selected }>Type</option>
						</select>
					</div>
				</div>

				<!-- Row 2: detail breakdowns + actions -->
				<div class="flex flex-wrap items-center gap-x-6 gap-y-2">
					<span class="text-sm font-medium text-gray-700">Break down by:</span>
					<label class="flex items-center cursor-pointer">
						<input type="checkbox" name="groupByDate" value="true" class="h-4 w-4 text-blue-600 border-gray-300 rounded" onchange="this.form.submit()" if opts.ByDate { checked }/>
						<span class="ml-2 text-sm text-gray-700">Month</span>
					</label>
					<label class="flex items-center cursor-pointer">
						<input type="checkbox" name="groupByCharge" value="true" class="h-4 w-4 text-blue-600 border-gray-300 rounded" onchange="this.form.submit()" if opts.ByCharge { checked }/>
						<span class="ml-2 text-sm text-gray-700">Project Charge</span>
					</label>
					<label class="flex items-center cursor-pointer">
						<input type="checkbox" name="groupByEmployee" value="true" class="h-4 w-4 text-blue-600 border-gray-300 rounded" onchange="this.form.submit()" if opts.ByEmployee { checked }/>
						<span class="ml-2 text-sm text-gray-700">Employee Type</span>
					</label>
					<label class="flex items-center cursor-pointer">
						<input type="checkbox" name="groupByRole" value="true" class="h-4 w-4 text-blue-600 border-gray-300 rounded" onchange="this.form.submit()" if opts.ByRole { checked }/>
						<span class="ml-2 text-sm text-gray-700">Role</span>
					</label>
					<label class="flex items-center cursor-pointer">
						<input type="checkbox" name="groupByLocation" value="true" class="h-4 w-4 text-blue-600 border-gray-300 rounded" onchange="this.form.submit()" if opts.ByLocation { checked }/>
						<span class="ml-2 text-sm text-gray-700">Location</span>
					</label>

					<div class="ml-auto flex gap-2">
						<button type="submit" class="inline-flex items-center px-3 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700">
							Apply
						</button>
						<button type="button" onclick="exportCSV()" class="inline-flex items-center px-3 py-2 text-sm font-medium text-white bg-green-600 rounded-md hover:bg-green-700">
							<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
							</svg>
							Export CSV
						</button>
					</div>
				</div>
			</div>

			<!-- Filter panel -->
			<div class="bg-white rounded-lg shadow-md p-4">
				<details if len(filters.Charges) > 0 || len(filters.Roles) > 0 || len(filters.Locations) > 0 || len(filters.EmpTypes) > 0 { open }>
					<summary class="cursor-pointer text-sm font-medium text-gray-700 select-none">Filters
						if len(filters.Charges) > 0 || len(filters.Roles) > 0 || len(filters.Locations) > 0 || len(filters.EmpTypes) > 0 {
							<span class="ml-2 px-2 py-0.5 bg-blue-100 text-blue-700 rounded-full text-xs">active</span>
						}
					</summary>
					<div class="mt-4 grid grid-cols-2 md:grid-cols-6 gap-6">

						<!-- Project Charge multi-select -->
						if len(filters.AllCharges) > 0 {
							<div class="col-span-2 md:col-span-3">
								<p class="text-xs font-semibold text-gray-500 uppercase mb-1">Project Charge</p>
								<p class="text-xs text-gray-400 mb-2">Hold Ctrl / ⌘ to select multiple</p>
								<select
									name="charge"
									multiple
									size="8"
									class="w-full border border-gray-300 rounded-md py-1 text-xs text-gray-700 focus:outline-hidden focus:ring-2 focus:ring-blue-500"
								>
									for _, c := range filters.AllCharges {
										<option value={ c } if contains(filters.Charges, c) { selected }>{ c }</option>
									}
								</select>
							</div>
						}

						<!-- Employee Type -->
						<div>
							<p class="text-xs font-semibold text-gray-500 uppercase mb-2">Employee Type</p>
							<div class="space-y-1">
								<label class="flex items-center gap-2 cursor-pointer">
									<input type="checkbox" name="empType" value="employee" class="h-3.5 w-3.5 text-blue-600 border-gray-300 rounded" if contains(filters.EmpTypes, "employee") { checked }/>
									<span class="text-xs text-gray-700">Employee</span>
								</label>
								<label class="flex items-center gap-2 cursor-pointer">
									<input type="checkbox" name="empType" value="contractor" class="h-3.5 w-3.5 text-blue-600 border-gray-300 rounded" if contains(filters.EmpTypes, "contractor") { checked }/>
									<span class="text-xs text-gray-700">Contractor</span>
								</label>
							</div>
						</div>

						<!-- Role -->
						if len(filters.AllRoles) > 0 {
							<div>
								<p class="text-xs font-semibold text-gray-500 uppercase mb-2">Role</p>
								<div class="space-y-1">
									for _, r := range filters.AllRoles {
										<label class="flex items-center gap-2 cursor-pointer">
											<input type="checkbox" name="role" value={ r } class="h-3.5 w-3.5 text-blue-600 border-gray-300 rounded" if contains(filters.Roles, r) { checked }/>
											<span class="text-xs text-gray-700">{ r }</span>
										</label>
									}
								</div>
							</div>
						}

						<!-- Location -->
						if len(filters.AllLocations) > 0 {
							<div>
								<p class="text-xs font-semibold text-gray-500 uppercase mb-2">Location</p>
								<div class="space-y-1">
									for _, l := range filters.AllLocations {
										<label class="flex items-center gap-2 cursor-pointer">
											<input type="checkbox" name="location" value={ l } class="h-3.5 w-3.5 text-blue-600 border-gray-300 rounded" if contains(filters.Locations, l) { checked }/>
											<span class="text-xs text-gray-700">{ l }</span>
										</label>
									}
								</div>
							</div>
						}

					</div>
					<div class="mt-4 flex gap-3">
						<button type="submit" class="px-4 py-1.5 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700">Apply Filters</button>
						<a href="/reports/project-hours" class="px-4 py-1.5 text-sm font-medium text-gray-600 bg-gray-100 rounded-md hover:bg-gray-200">Clear All</a>
					</div>
				</details>
			</div>
		</form>

		<script>
			function exportCSV() {
				const form = document.getElementById('filterForm');
				const data = new FormData(form);
				const params = new URLSearchParams(data);
				window.location.href = '/reports/project-hours/csv?' + params.toString();
			}
		</script>

		if len(data) == 0 {
			<div class="bg-yellow-50 border-l-4 border-yellow-400 p-4">
				<p class="text-yellow-700">No project charge hours data found.</p>
			</div>
		} else {
			<!-- Desktop view -->
			<div class="hidden md:block space-y-6">
				for _, project := range groupProjectChargeHours(data, opts) {
					<div class="bg-white rounded-lg shadow-md overflow-hidden">
						<!-- Project header -->
						<div class="bg-blue-600 text-white px-6 py-3 flex justify-between items-center">
							<h2 class="text-lg font-semibold">{ project.Name }</h2>
							<span class="text-lg font-bold">{ formatHours(project.Total) } hrs</span>
						</div>

						<table class="min-w-full divide-y divide-gray-200">
							<thead class="bg-gray-50">
								<tr>
									<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Project Charge</th>
									if opts.ByCharge && opts.ParentBy != "category" {
										<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
									}
									if opts.ByCharge && opts.ParentBy != "type" {
										<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
									}
									if opts.ByDate {
										<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Month</th>
									}
									if opts.ByEmployee {
										<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Employee</th>
									}
									if opts.ByRole {
										<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role</th>
									}
									if opts.ByLocation {
										<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Location</th>
									}
									<th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Hours</th>
								</tr>
							</thead>
							<tbody class="bg-white divide-y divide-gray-200">
								for _, charge := range project.Charges {
									for i, detail := range charge.DetailRows {
										<tr class="hover:bg-gray-50">
											if i == 0 {
												<td class="px-6 py-3 whitespace-nowrap" rowspan={ fmt.Sprintf("%d", len(charge.DetailRows)) }>
													<div class="text-sm font-medium text-gray-900">{ charge.Name }</div>
													<div class="text-xs text-gray-500">Subtotal: { formatHours(charge.Total) } hrs</div>
												</td>
												if opts.ByCharge && opts.ParentBy != "category" {
													<td class="px-6 py-3 whitespace-nowrap text-sm text-gray-700" rowspan={ fmt.Sprintf("%d", len(charge.DetailRows)) }>{ charge.Category }</td>
												}
												if opts.ByCharge && opts.ParentBy != "type" {
													<td class="px-6 py-3 whitespace-nowrap text-sm text-gray-700" rowspan={ fmt.Sprintf("%d", len(charge.DetailRows)) }>{ charge.Type }</td>
												}
											}
											if opts.ByDate {
												<td class="px-6 py-3 whitespace-nowrap text-sm text-gray-900">
													{ detail.YearMonth }
												</td>
											}
											if opts.ByEmployee {
												<td class="px-6 py-3 whitespace-nowrap">
													@employeeBadge(detail.IsEmployee)
												</td>
											}
											if opts.ByRole {
												<td class="px-6 py-3 whitespace-nowrap">
													@roleBadge(detail.Role)
												</td>
											}
											if opts.ByLocation {
												<td class="px-6 py-3 whitespace-nowrap">
													@locationBadge(detail.Location)
												</td>
											}
											<td class="px-6 py-3 whitespace-nowrap text-right text-sm text-gray-900">
												{ formatHours(detail.Hours) }
											</td>
										</tr>
									}
								}
							</tbody>
						</table>
					</div>
				}
			</div>

			<!-- Mobile view -->
			<div class="md:hidden space-y-4">
				for _, project := range groupProjectChargeHours(data, opts) {
					<div class="bg-white rounded-lg shadow-md overflow-hidden">
						<!-- Project header -->
						<div class="bg-blue-600 text-white px-4 py-3 flex justify-between items-center">
							<h2 class="text-base font-semibold">{ project.Name }</h2>
							<span class="text-base font-bold">{ formatHours(project.Total) } hrs</span>
						</div>

						<div class="divide-y divide-gray-200">
							for _, charge := range project.Charges {
								<div class="p-4">
									<div class="flex justify-between items-start mb-2">
										<div>
											<span class="text-sm font-medium text-gray-900">{ charge.Name }</span>
											if opts.ByCharge {
												switch opts.ParentBy {
													case "category":
														<div class="text-xs text-gray-500 mt-0.5">{ charge.Type }</div>
													case "type":
														<div class="text-xs text-gray-500 mt-0.5">{ charge.Category }</div>
													default:
														<div class="text-xs text-gray-500 mt-0.5">{ charge.Category } &bull; { charge.Type }</div>
												}
											}
										</div>
										<span class="text-sm font-semibold text-blue-600">{ formatHours(charge.Total) } hrs</span>
									</div>
									<div class="space-y-2">
										for _, detail := range charge.DetailRows {
											<div class="flex flex-wrap justify-between items-center text-sm gap-1">
												<div class="flex flex-wrap items-center gap-2">
													if opts.ByDate {
														<span class="text-xs text-gray-500">{ detail.YearMonth }</span>
													}
													if opts.ByEmployee {
														@employeeBadge(detail.IsEmployee)
													}
													if opts.ByRole {
														@roleBadge(detail.Role)
													}
													if opts.ByLocation {
														@locationBadge(detail.Location)
													}
												</div>
												<span class="text-gray-700">{ formatHours(detail.Hours) } hrs</span>
											</div>
										}
									</div>
								</div>
							}
						</div>
					</div>
				}
			</div>

			<!-- Summary stats -->
			<div class="mt-6 bg-white rounded-lg shadow-md p-6">
				<h3 class="text-lg font-semibold text-gray-900 mb-4">Summary</h3>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
					<div class="bg-blue-50 rounded-lg p-4">
						<div class="text-sm text-blue-600 font-medium">Total Projects</div>
						<div class="text-2xl font-bold text-blue-900">{ fmt.Sprintf("%d", countUniqueProjects(data)) }</div>
					</div>
					<div class="bg-green-50 rounded-lg p-4">
						<div class="text-sm text-green-600 font-medium">Total Hours</div>
						<div class="text-2xl font-bold text-green-900">{ formatHours(totalHours(data)) }</div>
					</div>
					<div class="bg-purple-50 rounded-lg p-4">
						<div class="text-sm text-purple-600 font-medium">Project Charges</div>
						<div class="text-2xl font-bold text-purple-900">{ fmt.Sprintf("%d", countUniqueCharges(data)) }</div>
					</div>
				</div>
			</div>
		}
	}
}

templ roleBadge(role string) {
	switch role {
		case "dev":
			<span class="px-2 py-1 text-xs rounded-full bg-blue-100 text-blue-800">dev</span>
		case "qa":
			<span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-800">qa</span>
		case "devOps":
			<span class="px-2 py-1 text-xs rounded-full bg-purple-100 text-purple-800">devOps</span>
		case "mgmt":
			<span class="px-2 py-1 text-xs rounded-full bg-orange-100 text-orange-800">mgmt</span>
		default:
			<span class="px-2 py-1 text-xs rounded-full bg-gray-100 text-gray-800">{ role }</span>
	}
}

templ employeeBadge(isEmployee bool) {
	if isEmployee {
		<span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-800">Employee</span>
	} else {
		<span class="px-2 py-1 text-xs rounded-full bg-yellow-100 text-yellow-800">Contractor</span>
	}
}

templ locationBadge(location string) {
	if location == "" || location == "Unknown" {
		<span class="px-2 py-1 text-xs rounded-full bg-gray-100 text-gray-800">Unknown</span>
	} else {
		<span class="px-2 py-1 text-xs rounded-full bg-indigo-100 text-indigo-800">{ location }</span>
	}
}

func contains(slice []string, val string) bool {
	for _, s := range slice {
		if s == val {
			return true
		}
	}
	return false
}

func countUniqueProjects(data []types.ProjectChargeHours) int {
	projects := make(map[string]bool)
	for _, item := range data {
		projects[item.Label] = true
	}
	return len(projects)
}

func totalHours(data []types.ProjectChargeHours) float64 {
	var total float64
	for _, item := range data {
		total += item.Hours
	}
	return total
}

func countUniqueCharges(data []types.ProjectChargeHours) int {
	charges := make(map[string]bool)
	for _, item := range data {
		charges[item.ProjectCharge] = true
	}
	return len(charges)
}

// formatHours formats a float with commas as thousands separator
func formatHours(n float64) string {
	// Format with 2 decimal places first
	s := fmt.Sprintf("%.2f", n)

	// Split into integer and decimal parts
	parts := strings.Split(s, ".")
	intPart := parts[0]
	decPart := parts[1]

	// Add commas to integer part
	var result strings.Builder
	negative := false
	if len(intPart) > 0 && intPart[0] == '-' {
		negative = true
		intPart = intPart[1:]
	}

	for i, c := range intPart {
		if i > 0 && (len(intPart)-i)%3 == 0 {
			result.WriteRune(',')
		}
		result.WriteRune(c)
	}

	formatted := result.String()
	if negative {
		formatted = "-" + formatted
	}

	return formatted + "." + decPart
}
