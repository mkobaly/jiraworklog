templ customerBugsChartScript() {
	<script>
		function applyFilters() {
			const project = document.getElementById('project-select').value;
			//const aggregate = document.getElementById('aggregate-checkbox').checked;

			const params = new URLSearchParams();
			if (project) {
				params.set('project', project);
			}
			// if (aggregate) {
			// 	params.set('aggregate', 'true');
			// }
			const queryString = params.toString();
			window.location.href = '/reports/customer-bugs' + (queryString ? '?' + queryString : '');
		}

		
		function initStabilityChart() {
			const el = document.getElementById('stabilityData');
			if (!el) return;
			const d = JSON.parse(el.dataset.chart);
			const ctx = document.getElementById('stabilityChart').getContext('2d');
			new Chart(ctx, {
				type: 'line',
				data: {
					labels: d.labels,
					datasets: [
						{ label: 'Total', data: d.open,   borderColor: 'rgba(59,130,246,1)',  backgroundColor: 'rgba(59,130,246,0)', borderWidth: 2, tension: 0.3, pointRadius: 3, fill: true },
						{ label: 'Completed', data: d.closed, borderColor: 'rgba(249,115,22,1)',  backgroundColor: 'rgba(249,115,22,0)', borderWidth: 2, tension: 0.3, pointRadius: 3, fill: true },
						{ label: 'New',        data: d.new,    borderColor: 'rgba(156,163,175,1)', backgroundColor: 'rgba(156,163,175,0)', borderWidth: 2, tension: 0.3, pointRadius: 3, fill: true },
					]
				},
				options: {
					responsive: true,
					maintainAspectRatio: false,
					interaction: { intersect: false, mode: 'index' },
					plugins: {
						//title: { display: true, text: 'Stability Team Performance', font: { size: 16 } },
						legend: { position: 'right' }
					},
					scales: {
						x: { grid: { display: false } },
						y: { beginAtZero: true, title: { display: true, text: 'Bug Count' } }
					}
				}
			});
		}

		// Wait for Chart.js to be available before initializing
		function waitForChart() {
			if (typeof Chart !== 'undefined') {
				//initCustomerBugsChart();
				initStabilityChart();
			} else {
				setTimeout(waitForChart, 50);
			}
		}
		waitForChart();
	</script>
}

// AggregatedBugCount represents bug counts aggregated by project and month
type AggregatedBugCount struct {
	Project   string
	YearMonth string
	Count     int
}

