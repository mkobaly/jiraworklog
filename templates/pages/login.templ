package pages

import "github.com/mkobaly/jiraworklog/templates/layouts"

templ Login(msg string) {
	@layouts.BasePublic("Login") {
		<div class="flex items-center justify-center min-h-[60vh]">
			<div class="bg-white rounded-lg shadow-md p-8 w-full max-w-md">
				<h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Login to Jira Manager</h2>
				<form action="/login" method="POST" class="space-y-4">
					<div>
						<label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
						<input
							type="email"
							id="email"
							name="email"
							required
							placeholder="Enter your email address"
							class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
						/>
					</div>
					<button
						type="submit"
						class="w-full px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition font-medium"
					>
						Email me a one time code
					</button>
				</form>
				if msg != "" {
					<div class="mt-4 bg-red-50 border-l-4 border-red-400 p-4">
						<p class="text-sm text-red-700">{ msg }</p>
					</div>
				}
			</div>
		</div>
	}
}

templ FailedLogin() {
	@layouts.BasePublic("Unauthorized") {
		<div class="flex items-center justify-center min-h-[60vh]">
			<div class="bg-white rounded-lg shadow-md p-8 w-full max-w-md text-center">
				<div class="mb-4">
					<svg class="mx-auto h-12 w-12 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
					</svg>
				</div>
				<h2 class="text-2xl font-bold text-gray-900 mb-2">Unauthorized</h2>
				<p class="text-gray-600 mb-6">This email address is not authorized to access this application.</p>
				<a
					href="/login"
					class="inline-block px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition font-medium"
				>
					Back to Login
				</a>
			</div>
		</div>
	}
}

templ LoginConfirm(email, msg string) {
	@layouts.BasePublic("Confirm Login") {
		<div class="flex items-center justify-center min-h-[60vh]">
			<div class="bg-white rounded-lg shadow-md p-8 w-full max-w-md">
				<h2 class="text-2xl font-bold text-gray-900 mb-2 text-center">Enter Email Code</h2>
				<p class="text-gray-600 text-sm text-center mb-6">A one time code has been sent to your email. Enter it below to complete login.</p>
				<form action="/login/confirm" method="POST" class="space-y-4">
					<div>
						<label for="code" class="block text-sm font-medium text-gray-700 mb-1">Email Code</label>
						<input
							type="text"
							id="code"
							name="code"
							required
							placeholder="Enter your code"
							class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
						/>
					</div>
					<input type="hidden" name="email" value={ email }/>
					<button
						type="submit"
						class="w-full px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition font-medium"
					>
						Login
					</button>
				</form>
				if msg != "" {
					<div class="mt-4 bg-red-50 border-l-4 border-red-400 p-4">
						<p class="text-sm text-red-700">{ msg }</p>
					</div>
				}
			</div>
		</div>
	}
}
